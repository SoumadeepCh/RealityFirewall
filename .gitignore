# ----------------------------------------------------------------------
# 🚫 MODELS, WEIGHTS & MACHINE LEARNING
# ----------------------------------------------------------------------
# Exclude all actual trained model weights and data
*.pth
*.pt
*.h5
*.hdf5
*.onnx
*.tflite
*.pkl
*.joblib
*.lgb
*.pb
*.ckpt
ai-service/model_weights/*
!ai-service/model_weights/.gitkeep
!ai-service/model_weights/*.json

# ----------------------------------------------------------------------
# 🚫 DATASETS & MEDIA FILES
# ----------------------------------------------------------------------
# Exclude datasets and uploaded/processed media
*.csv
*.tsv
*.jsonl
*.parquet
ai-service/data/
ai-service/datasets/
ai-service/uploads/
ai-service/temp/
ai-service/tmp/

# Video/Audio/Image test files anywhere in ai-service
ai-service/**/*.mp4
ai-service/**/*.avi
ai-service/**/*.mov
ai-service/**/*.mkv
ai-service/**/*.wav
ai-service/**/*.mp3
ai-service/**/*.flac

# Specifically exclude large AI dataset directories
celeb-deepfakeforensics-master/
**/Celeb-DF*/
**/FaceForensics*/
**/FF++*/
**/DFDC*/
**/celeb-df*/
